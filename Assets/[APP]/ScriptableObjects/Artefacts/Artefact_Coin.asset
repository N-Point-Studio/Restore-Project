  baseData:
    id: Artefact_Coin
    itemName: "Coin inscribed \u201CChong Ning Tong Bao\u201D"
    itemDescription: "The characters on this coin exhibit Emperor Huizong\u2019s
      distinctive calligraphic style, known as \u201Cslender gold\u201D because it
      resembled finely spun filaments of the precious metal. Huizong made an effort
      to present himself as a man of cultivated tastes through various means. His
      writings were often carved in stone or metal, as here, and circulated widely
      among the public."
    itemIcon: {fileID: 21300000, guid: 832d6354fe4ce904aa36ba6cf9e86327, type: 3}
    exclude: 0
  stickyNoteTexts:
  - "Here\u2019s your first artifact, Nova.\nI hope this is a beautiful start to
    your journey here!\n\n-Mrs. Maya :)"
  - P.S Amazing to see this project in the hands of someone so competent! I know
    I can trust you.
  preRestorationPagePrefab: {fileID: 8636906436748886089, guid: 0ced2ee71da87fd4ba9f027556a9e73f, type: 3}
  postRestorationPagePrefab: {fileID: 8866635996392126511, guid: b4b30d70204886846819ce23ac025ee4, type: 3}
